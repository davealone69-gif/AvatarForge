<?xml version="1.0" encoding="utf-8"?>
<!--
  The app icon: a figure built from the same primitives the engine uses (a capsule torso, a sphere
  head, a sphere eye with a refraction arc) on the renderer's background colour. Vector, so it costs
  1 kB and stays sharp at any launcher size.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="@color/launcher_background"
        android:pathData="M0,0 h108 v108 h-108 z" />
    <!-- torso -->
    <path
        android:fillColor="#FF6FB6FF"
        android:fillAlpha="0.92"
        android:pathData="M46,58 h16 a6,6 0 0 1 6,6 v22 a4,4 0 0 1 -4,4 h-20 a4,4 0 0 1 -4,-4 v-22 a6,6 0 0 1 6,-6 z" />
    <!-- head -->
    <path
        android:fillColor="#FFE8C39E"
        android:pathData="M54,22 m-14,0 a14,15 0 1 0 28,0 a14,15 0 1 0 -28,0" />
    <!-- eye -->
    <path
        android:fillColor="#FF1B2330"
        android:pathData="M60,24 m-3.2,0 a3.2,3.2 0 1 0 6.4,0 a3.2,3.2 0 1 0 -6.4,0" />
    <!-- cornea highlight: the renderer's refracting cornea, reduced to one arc -->
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.6"
        android:strokeLineCap="round"
        android:pathData="M63.4,21.4 a3.2,3.2 0 0 1 0.2,4.2" />
    <!-- arms -->
    <path
        android:fillColor="#FF5FA3E8"
        android:pathData="M44,60 h-4 a3,3 0 0 0 -3,3 v20 a2.5,2.5 0 0 0 5,0 v-14 h2 z" />
    <path
        android:fillColor="#FF5FA3E8"
        android:pathData="M64,60 h4 a3,3 0 0 1 3,3 v20 a2.5,2.5 0 0 1 -5,0 v-14 h-2 z" />
</vector>
