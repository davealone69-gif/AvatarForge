# Copy to local.properties (which is git-ignored) and point sdk.dir at your Android SDK.
# The NDK must be the one the CMake toolchain file names below, or the exported ANDROID_NDK_HOME.
sdk.dir=/path/to/android-sdk
ndk.dir=/path/to/android-sdk/ndk/26.1.10909125

# ---------------------------------------------------------------------------------------------
# Release signing. Copy the four keys below into keystore.properties at the repo root (or export the
# AF_RELEASE_* variables) and the release build will use that keystore. There is NO debug-keystore
# fallback: without a real keystore the release build FAILS unless you pass
# -Paf.allowUnsignedRelease=true, which produces an explicitly UNSIGNED, non-updatable artifact for
# compile checks only. The debug APK (assembleDebug) is the only debug-signed output.
# ---------------------------------------------------------------------------------------------
# storeFile=/absolute/path/to/avatarforge-release.jks
# storePassword=...
# keyAlias=avatarforge
# keyPassword=...
