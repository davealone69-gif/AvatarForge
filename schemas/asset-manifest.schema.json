{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AvatarForge offline asset manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "assets"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "assets": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "path", "version"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
          "type": { "enum": ["character_preset", "material", "skeleton", "animation", "blendshape", "procedural_parameters", "renderer_settings", "reference_image"] },
          "path": { "type": "string", "minLength": 1, "maxLength": 240, "pattern": "^[A-Za-z0-9._/-]+$" },
          "version": { "type": "integer", "minimum": 1 },
          "dependencies": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" } },
          "license": { "type": "string", "maxLength": 200 },
          "source": { "type": "string", "maxLength": 1000 }
        }
      }
    }
  }
}
